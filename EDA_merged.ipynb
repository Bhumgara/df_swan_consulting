  },
  {
   "cell_type": "markdown",
   "id": "0822869f",
   "metadata": {},
   "source": [
    "# 2. Cleaning"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "81dff552",
   "metadata": {},
   "outputs": [],
   "source": [
    "df_clean = df.copy()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "bbbabbc4",
   "metadata": {},
   "outputs": [],
   "source": [
    "df_clean['Total Charges'] = pd.to_numeric(df_clean['Total Charges'], errors='coerce').fillna(0.0)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "85be61a6",
   "metadata": {},
   "outputs": [],
   "source": [
    "addons = ['Online Security', 'Online Backup', 'Device Protection',\n",
    "          'Tech Support', 'Streaming TV', 'Streaming Movies']\n",
    "df_clean[addons] = df_clean[addons].replace('No internet service', 'No')\n",
    "df_clean['Multiple Lines'] = df_clean['Multiple Lines'].replace('No phone service', 'No')"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "9089d7bb",
   "metadata": {},
   "source": [
    "# 3. Feature Engineering"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "74657d8a",
   "metadata": {},
   "outputs": [],
   "source": [
    "DROPS = [\n",
    "    \"Count\", \"Country\", \"State\",\n",
    "    \"CustomerID\",\n",
    "    \"Churn Label\", \"Churn Value\",\n",
    "    \"Churn Reason\",\n",
    "    \"Lat Long\",\n",
    "    \"City\", \"Zip Code\", \"Latitude\", \"Longitude\",\n",
    "    \"Total Charges\",\n",
    "]\n",
    "\n",
    "customer_ids = df_clean[\"CustomerID\"]\n",
    "y = df_clean[\"Churn Value\"]\n",
    "X = df_clean.drop(columns=DROPS)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cce45ccf",
   "metadata": {},
   "outputs": [],
   "source": [
    "X_enc = pd.get_dummies(X, drop_first=True, dtype=int)\n",
    "FEATURE_COLUMNS = list(X_enc.columns)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "f970197f",
   "metadata": {},
   "outputs": [],
   "source": [
    "X_enc.head()"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "03da582e",
   "metadata": {},
   "source": [
    "# 4. Scaling"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "edb89ac4",
   "metadata": {},
   "outputs": [],
   "source": [
    "NUMERIC = [\"Tenure Months\", \"Monthly Charges\"]\n",
    "\n",
    "scaler = StandardScaler()\n",
    "X_enc[NUMERIC] = scaler.fit_transform(X_enc[NUMERIC])"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "5a9ec37e",
   "metadata": {},
   "outputs": [],
   "source": [
    "X_enc[NUMERIC].describe()"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "18ba8866",
   "metadata": {},
   "source": [
    "# 5. Fitting the Model"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "244596be",
   "metadata": {},
   "outputs": [],
   "source": [
    "X_train, X_test, y_train, y_test = train_test_split(\n",
    "    X_enc, y, test_size=0.2, random_state=42, stratify=y)\n",
    "\n",
    "model = LogisticRegression(max_iter=300, random_state=42)\n",
    "model.fit(X_train, y_train)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "388c93be",
   "metadata": {},
   "outputs": [],
   "source": [
    "model.score(X_test, y_test)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "4e510d8b",
   "metadata": {},
   "outputs": [],
   "source": [
    "results = X_test.copy()\n",
    "results[['prob_stay', 'prob_churn']] = model.predict_proba(X_test)\n",
    "results['y_pred'] = np.where(results['prob_churn'] > .5, 1, 0)\n",
    "\n",
    "roc_auc_score(y_test, results['prob_churn'])"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "e958fed1",
   "metadata": {},
   "outputs": [],
   "source": [
    "results.head()"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "22d8e3e5",
   "metadata": {},
   "source": [
    "# 6. Metrics"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "b7982fa6",
   "metadata": {},
   "outputs": [],
   "source": [
    "def produce_confusion(positive_label, negative_label, cut_off, df, y_pred_name, y_real_name):\n",
    "    pred = df[y_pred_name] if cut_off == 'binary' else np.where(df[y_pred_name] > cut_off, 1, 0)\n",
    "\n",
    "    cm = confusion_matrix(df[y_real_name], pred)\n",
    "    fig, ax = plt.subplots(figsize=(5, 4))\n",
    "    sns.heatmap(cm, annot=True, ax=ax, fmt='g', cmap='Blues', cbar=False)\n",
    "\n",
    "    ax.set_xlabel('Predicted labels')\n",
    "    ax.set_ylabel('Real labels')\n",
    "    ax.set_title('Confusion Matrix')\n",
    "    ax.xaxis.set_ticklabels([negative_label, positive_label])\n",
    "    ax.yaxis.set_ticklabels([negative_label, positive_label])\n",
    "    plt.show()\n",
    "\n",
    "    acc = accuracy_score(df[y_real_name], pred)\n",
    "    print('Test accuracy = ', acc)\n",
    "    return acc"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "ac8dbdcf",
   "metadata": {},
   "outputs": [],
   "source": [
    "results['y_real'] = y_test\n",
    "produce_confusion('Churned', 'Retained', 'binary', results, 'y_pred', 'y_real')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "d7265f53",
   "metadata": {},
   "outputs": [],
   "source": [
    "print(metrics.classification_report(y_test, results['y_pred']))"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "bc9f1e63",
   "metadata": {},
   "source": [
    "# 7. Finding the Best Threshold Value"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "0ddcbda4",
   "metadata": {},
   "outputs": [],
   "source": [
    "for cut in [0.2, 0.25, 0.3, 0.35, 0.4, 0.45, 0.5]:\n",
    "    pred = np.where(results['prob_churn'] > cut, 1, 0)\n",
    "    print(f\"{cut:.2f}  acc {metrics.accuracy_score(y_test, pred):.3f}\"\n",
    "          f\"  recall {metrics.recall_score(y_test, pred):.3f}\"\n",
    "          f\"  precision {metrics.precision_score(y_test, pred):.3f}\"\n",
    "          f\"  f1 {metrics.f1_score(y_test, pred):.3f}\")"
   ]
  },
  {
